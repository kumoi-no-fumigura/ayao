 ],
 "poems": [
  {
   "seq": "1",
   "text": "鶯比こゑも手おとるあゝちして袖にちりくる梅比はなかな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "三輪の山霞にこもる春しもぞ木のまの花いあらはれにける",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さくらさく春べになれバ昔せし志賀比山越おもほゆるかな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ちるまで北日數ほどなき花なれバ雨も嵐もきそひさつらむ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "菅の根の永き春日にうちはへておもふまゝふも遊ぶ糸ゆふ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "うちなびく春の霞の上でらいとほき海さへ見えきさるかな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ちらぞしてまち試とよ櫻ばなつひおい人のあくやあかずや",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "音羽山木比まの花もあらはれてほ〓〓〓〓らむ月のかげ哉",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ゆふ月のかげ比うつろふ池水にふる雨見えてかはづなくえ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "もゝち鳥さへづりかはす聲の中お殘すくなくなりし春かな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "あまりにも霞む月かな中ぞらに山比端ならで影やかくれむ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山比端をいでを離れそ大空にのぼれバあくる夏比夜のつき",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "かはほりのとびかふ影も見ゆるかな木間よりてる月比光お",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "白雲のたちかさなりて筑波山なつのかげおもなりおける哉",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "螢とぶ川せの浪い夏なれどまつのぜさむし宇治のやまもと",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "夕風おのりて過たるむら雨のなどはちも葉比玉となりけむ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "雨雲につゝみあまりて時鳥こぼるゝばかり名のるこゑかな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "なほあほし梢とほりてふりし雨蟬比聲をがぬらさやりけむ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "桂川やなあす年魚のかげ見えて廣瀬すゞしき夏の夜のつき",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "けさ見れバよのまに夏になりおけり雲さへ空に白重ねしつ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "けさもまた朝日隔てゝたつ雲のはれなむ後の暑さをぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "水無月の夕日がくれのあと見れバもゆばかりなる雲の色哉",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "水無月のてる日の影おさく花の色とも見えぬ風のすゞしさ",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "〓ら川北關ふてあひぬ越路より渡るときゝし秋北かりがね",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "香をとめて露もおくらむてる月の影ふまがへる白菊のはな",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "山かげの池比そこなる玄ら菊い波よりほかふをる人もなし",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "麓あてほのかにきゝしさを鹿の聲のところふ我い來おけり",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "いとヾ我心ぞやみおなりおける稻妻ばかりかげを見しより",
   "kana": "",
   "speaker": "",
   "page": 180,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "うち靡く霞ながらにさほ姫のかくるや花のかつらきのやま",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "玄づ枝まで浪うちかけて引し世を岸の姫松けふや戀ふらむ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "墨の江の浦風なぎて松の葉のいろもひとしほ霞むはるかな",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "さしおほふ松の雫に苦むしてにはの色さへときはなりけり",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "あくる夜を鳥い〓てわざれどもつとむる業もなき身んけり",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あけぬとや霜の光ふまどひけむ夜鴉さわぐもりのうへかな",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "むら千鳥なきたつ見れバ墨の江の蘆ベハ波おなりふける哉",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "浪の音とほくきく世ふあはむとい岸の姫松おもはざりけむ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "住比江のをかの司おかげふりぬこれや昔のきしのひめまつ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "朝な〓〓霜おかれゆく八千種の花野のはてぞ悲しかりける",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "わさつみの果此遠山ほのかおも入日の影ふあらはれおけり",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "萬代をまつの木高くぬる鶴いみるべき夢もあらじとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "夕ごりの雲ふきはらふ木枯おひかりさえゆく冬の夜のつき",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "影こほる霜夜の月おむかはめやさきぬる梅の木間ならずび",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "かつさきて春まつ梅れ花の上おあまり寒けき月比かげうな",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "おく霜のあゝのかさね比菊北はなおほ宮人も打まどふらむ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "久かさ比雲井比庭のきくの花いかなる霜りうへにおくらむ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "てる月の三笠の野邊のむら時雨ふしたる玄かや驚かもらむ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "心あれや雪おもしろき島かげのいり江の浪おつりたるゝ人",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "山ざともあらはになれる冬しもぞ落葉に道いたえ增り〓る",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "あけわさる大原山いすみがまの烟よりこそあらはれふけれ",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "舟とむる加古の湊の石がきにゆふしほみちて千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "ひとむらの風の浮雲てる月ふかゝりもあへず時雨きふけり",
   "kana": "",
   "speaker": "",
   "page": 181,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "雲井おて今までなきし夕ひばりこの麥畑おおちて來おけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "はる霞かをみて遠し春の野いおぼろ月夜おなりおけるかな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "遠山比りもミ比上おのこりさる雪いなか〓〓めづらしき哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "去年の雪いまざ殘りて春も猶さやかに見ゆるかゞみ山かな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "谷かげみ幾日ならして鶯の今日いでそむるはつねなるらむ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "ふけわたる朧月夜の細殿おひとなつかしくにほふうめが香",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "そことなく霞みわされる春の夜い梅のにほひも朧なりけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "かも川のきしの柳のかげおこそ魚も長閑ふわそぶべらなれ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "むろのとを漕出て見れバ萬代のかめ島かけてかすみ棚びく",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "七種を出てつみさるあしたより野邊の景色い春めきおけり",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "あとつけて思ひ定めむ夕月のかげうとたどる庭の玄らゆき",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "信樂の外山の里のふゆごもり思ひやらるゝゆふけぶりかな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "ふりさまる雪も氷れる椎柴にあさかぜわさる音比さむけさ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "月ふけて杉むらくらきさ夜中ふ駒ひきこゆるあふ坂のやま",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "まさ更に君ぞこひしきなぞらへて思ひし花の咲そめしより",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "たゞす川かは音たかし御祓していくらの罪り今日流しけむ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "辛崎のあしまに舟をよせされバ袖おほさるのみざれける哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "五月雨に軒のわか竹うち靡きをぐらくなれる窓のうちかな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "つかれたる駒の眠もさめおけり山ほとゝぎす空おを北りて",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "さえかへりいまざ越路い寒からし心してゆけ春のかりがね",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "網おろもあまの小ぶねも見ゆる哉さかひ北浦比霞がくれお",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "磯山のはない霞みて見えねども春のふなぢのおもしろき哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "おのづから風もなき日おちる花い木陰ふのみも積りける哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "あかぞみる花の木かげお響くなり麓のてらのいりあひの鐘",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "けふも猶さかりなる哉やま里いはな北心も比どけかるらし",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "覺束なわがうゑおきし故〓のさくらい誰ゐ見られてりちる",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "逢坂の杉比木せまにさく花のかげい〓水にうつりけるかな",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "淵の上になみもさせがで大井川さやかにうつる花比かげ哉",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "今日もまさ嵐ぞさむきあらし山我まつ花いいつりさくらむ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "おもしろや花の都いかぐ山のまつの木のまにうち霞みつゝ",
   "kana": "",
   "speaker": "",
   "page": 182,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "粟田山もみぢいいまざ薄けれどたちわかれたる松の色かな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "月見むと窓あけされバ閨の中お軒端比〓比かげぞうつれる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "門さしてねむと思へバ山のはお廿日の月ぞすみのがりける",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "あま小舟つなぎ捨さるわたつみの洲崎の蘆に秋かぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "女郞花さきさる野邊をさちどおて妻こひあかもさを鹿の聲",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "墨染比ゆふべに見れバもみぢ葉升色てる山も寂しかりけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "さやかにも見え渡るかなもみぢ葉の木間お落る白川のたき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "秋比野の色比千種をませ比中お盡して匂ふきくのはなかな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "うちわたす峯の松原あらはれて今クにほへる秋比夜のつき",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "あま小舟あまさ沖べに見ゆる哉つき北光ああびきすらしも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "わが影いうつらざれども打向ひあかぬい月のかゞみんけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "ひさかさの桂男おうちむかひ身のむかしをも思ふ夜はかな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "うちむかふ心の隈やうつりけむ月のかゞみふ雲ぞかゝれる",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "秋ぎりの絕まに見ゆる山かげの尾花が原ふいり日さすなり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "夕月ハ門田の小田に移るまでうしろ北山にひぐらしのなく",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "播磨がさあこの鹽屋の夕けぶり浪路の末にたなびきおけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "雪まじり杉の枯葉をふきおろすくらまの山の風のさむけさ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "この夕ベ舟比帆影もうつるまでなぎわさりたる海の面かな",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "かの山の松いかもみやそめつらむ棚びくなべに色增りけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "こぬ人をまちふかしてもみる月の光いいとヾみおぞ𛁈みける",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "篠すゝきほお出てなびく秋風い戀しき人の身おも玄むらむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "三重にゆふ七子の帶のとけがさくみゆる心を戀ひ增りつゝ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "一度のあふせもなくてなみざ河ひろくも世おい流れける哉",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "あけはてバ道の人めをいかゞせむいざ別れなむ夜い深くとも",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "玄のすゝき今日まで穗ふも出ざりし下の思をいひや晴さむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "さ夜中と靜まりはてぬたが家も春の設けやとゝ比ひぬらむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "あなわびし霙おなりてふる雨い簑比玄さまでとほりける哉",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "白雪のつもりてはれし山のはを出さる月のかげのさむけさ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "さむげおも一聲なけり洲崎なるたづが超ふ𛁈もやおくらむ",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "都より松のこのまに見えつるいこの山里のもみぢなりけり",
   "kana": "",
   "speaker": "",
   "page": 183,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "谷かげの岩間をおつる山水を松のひヾきとおもひけるかな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "なか〓〓に靜けきものいかねの音に驚かされし寐覺えけり",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "夕波に舟いかくれてはる〓〓と帆影比みこそ見え渡りけれ",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "うちわたす麓いくれて山の端の紅葉にのこる夕づく日かな",
   "kana": "",
   "speaker": "",
   "page": 184,
   "pid": "993388",
   "form": "短歌",
   "genre": ""
  }
 ],
